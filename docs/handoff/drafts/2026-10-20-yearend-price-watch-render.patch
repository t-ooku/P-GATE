+// 2026-10-20 年末の希望価格テスト（docs/handoff/2026-10-19-yearend-price-watch-experiment.md）の下書き:
+// 実験 JSON（ops/social/experiments/*.json）の4枚の文字構成に、その日の本番の実画面を組み合わせる。
+// 撮る場所は既存セットと同じ（ホシルバズの棚・検索フォーム）。価格ぼかし・写真の下帯・OCR は capture() のまま。
+// 出力は <outDir>/experiment-<set id>/ に 1.jpg〜4.jpg。毎日の差し替え（src/social-screens.mjs）の対象外。
+const EXPERIMENT_SHOTS = Object.freeze([
+  Object.freeze({ url: '/#tab-buzz', selector: '#buzzTab .buzz-home-shelf', min: 4, nth: 0, labelFrom: 'h3' }),
+  Object.freeze({ url: SEARCH_SLIDE.url, selector: SEARCH_SLIDE.selector, min: SEARCH_SLIDE.min, fromTop: true }),
+  // 「🔔 価格通知」ボタン（.buzz-home-watch）が並ぶ棚
+  Object.freeze({ url: '/#tab-buzz', selector: '#buzzTab .buzz-home-shelf', min: 4, nth: 1, labelFrom: 'h3' }),
+  Object.freeze({ url: '/#tab-buzz', selector: '#buzzTab .buzz-home-shelf', min: 4, nth: 2, labelFrom: 'h3' })
+]);
+// 共通のスライド（slideHtml）は見出し2行・本文2行の枠。3行の見出しは、文言を変えずに改行だけ詰めて2行にする
+// （1行14字・66px で 952px の幅に収まる）。詰めても収まらなければ作らない（はみ出した素材を出さない）。
+const EXPERIMENT_LINE_MAX = 14;
+export function fitTwoLines(text, code) {
+  const lines = String(text || '').split('\n').map((line) => line.trim()).filter(Boolean);
+  while (lines.length > 2) {
+    let best = -1;
+    for (let i = 0; i < lines.length - 1; i += 1) {
+      const merged = lines[i].length + lines[i + 1].length;
+      if (merged <= EXPERIMENT_LINE_MAX && (best < 0 || merged < lines[best].length + lines[best + 1].length)) best = i;
+    }
+    if (best < 0) throw new Error(code);
+    lines.splice(best, 2, `${lines[best]}${lines[best + 1]}`);
+  }
+  if (lines.some((line) => line.length > EXPERIMENT_LINE_MAX * 2)) throw new Error(code);
+  return lines.join('\n');
+}
+export function experimentScreenSet(experiment, setIndex = 0) {
+  const set = experiment?.sets?.[setIndex];
+  if (!set || !/^[a-z0-9-]{3,80}$/u.test(String(set.id || ''))) throw new Error('EXPERIMENT_SET_INVALID');
+  const slides = Array.isArray(set.slides) ? set.slides : [];
+  if (slides.length !== EXPERIMENT_SHOTS.length) throw new Error(`EXPERIMENT_SLIDES_${slides.length}`);
+  return {
+    setId: `experiment-${set.id}`,
+    slides: slides.map((slide, index) => Object.freeze({
+      ...EXPERIMENT_SHOTS[index],
+      id: `${set.id}-${index + 1}`,
+      kicker: String(slide.kicker || ''),
+      title: fitTwoLines(slide.headline, `EXPERIMENT_HEADLINE_TOO_LONG:${index + 1}`),
+      body: fitTwoLines(slide.body, `EXPERIMENT_BODY_TOO_LONG:${index + 1}`)
+    }))
+  };
+}
+
 async function main() {
   const args = process.argv.slice(2);
-  outDir = args.find((value, index) => !value.startsWith('--') && args[index - 1] !== '--base') || '';
   const baseIndex = args.indexOf('--base');
   if (baseIndex >= 0) BASE = String(args[baseIndex + 1] || '').replace(/\/$/u, '');
-  if (!outDir || !/^https?:\/\//u.test(BASE)) throw new Error('usage: build-social-screens.mjs <outDir> [--base URL]');
+  const experimentIndex = args.indexOf('--experiment');
+  const experimentPath = experimentIndex >= 0 ? String(args[experimentIndex + 1] || '') : '';
+  outDir = args.find((value, index) => !value.startsWith('--') && !['--base', '--experiment'].includes(args[index - 1])) || '';
+  if (!outDir || !/^https?:\/\//u.test(BASE)) throw new Error('usage: build-social-screens.mjs <outDir> [--base URL] [--experiment JSON]');
+  const experiment = experimentPath ? experimentScreenSet(JSON.parse(await readFile(experimentPath, 'utf8'))) : null;
   const { chromium } = await import('playwright');
@@ -660,3 +708,4 @@ async function main() {
