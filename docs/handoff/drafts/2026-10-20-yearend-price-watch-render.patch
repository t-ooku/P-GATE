@@ -347 +347,25 @@ test('自動の撮影はバリューコマースの表示の計測に入れな
 });
+
+test('年末の希望価格テスト（下書き）: 実験JSONの4枚を実画面の撮影先に対応づけ、毎日の差し替えの対象外にする', async () => {
+  const { experimentScreenSet } = await import('../scripts/build-social-screens.mjs');
+  const experiment = JSON.parse(readFileSync(new URL('../ops/social/experiments/yearend-price-watch-20261019.json', import.meta.url), 'utf8'));
+  const { setId, slides } = experimentScreenSet(experiment);
+  assert.equal(setId, 'experiment-user-yearend-price-watch-20261019');
+  assert.equal(slides.length, 4);
+  for (const [index, slide] of slides.entries()) {
+    // 文言は変えない（改行だけ詰めて見出し・本文とも2行以内）
+    assert.equal(slide.title.replace(/\n/gu, ''), experiment.sets[0].slides[index].headline.replace(/\n/gu, ''));
+    assert.equal(slide.body.replace(/\n/gu, ''), experiment.sets[0].slides[index].body.replace(/\n/gu, ''));
+    assert.ok(slide.title.split('\n').length <= 2 && slide.body.split('\n').length <= 2, slide.id);
+    assert.ok(slide.url && slide.selector, slide.id);
+    // 価格ぼかし・写真の下帯を外す指定（mask:false / unmask）は持たない
+    assert.equal(slide.mask, undefined);
+    assert.equal(slide.unmask, undefined);
+  }
+  assert.equal(slides[0].title, '年末の買い物、\n先に予算を決めておく。');
+  assert.throws(() => experimentScreenSet({ sets: [{ id: 'x-y-z', slides: [{}, {}] }] }), /EXPERIMENT_SLIDES_2/u);
+  assert.throws(() => experimentScreenSet({ sets: [{ id: 'x-y-z', slides: [{ headline: 'あいうえおかきくけこ\nさしすせそたちつてと\nなにぬねのはひふへほ' }, {}, {}, {}] }] }), /EXPERIMENT_HEADLINE_TOO_LONG:1/u);
+  assert.throws(() => experimentScreenSet({ sets: [{ id: '../bad', slides: [] }] }), /EXPERIMENT_SET_INVALID/u);
+  assert.deepEqual(screenSetsForRow({ content_id: 'experiment-user-yearend-price-watch-20261019', link: 'https://hoshilu.app/' }, '2026-11-02'), []);
+  assert.deepEqual(screenSetsForRow({ content_id: 'carousel-user-price-watch' }, '2026-11-02'), ['drops', 'buzz', 'notes']);
+});
