{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-gate-line-bridge",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["enable_request_signal"],
  "routes": [
    {
      "pattern": "hoshilu.app",
      "custom_domain": true
    },
    {
      "pattern": "www.hoshilu.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "MARKETPLACE_PRICE_CACHE_ENABLED": "true",
    "AMAZON_ASSOCIATE_TAG": "hoshilu00-22",
    "VC_SID": "3779199",
    "VC_PID": "892690168",
    "VC_GO_REFERRAL_ENABLED": "false",
    "AMAZON_CREATORS_CREDENTIAL_VERSION": "2.3",
    "INSTAGRAM_APP_ID": "1349062573483200",
    "INSTAGRAM_ACCOUNT_ID": "17841441143206766",
    "INSTAGRAM_EXPECTED_USERNAME": "hoshilu.app",
    "INSTAGRAM_OAUTH_REDIRECT_URI": "https://hoshilu.app/api/oauth/instagram/callback",
    "MEMBER_EMAIL_FROM": "notification@auth.hoshilu.app",
    "SELLER_INQUIRY_NOTIFY_EMAIL": "t.ookutsu19850613@gmail.com",
    "SELLER_OUTREACH_FROM": "sellers@auth.hoshilu.app",
    "INTERNAL_MEMBER_IDS": "6vw0RVMxRXk89RKCpmkhSDhUPzNAhbKf77VLzXvKYfs,IEpqu7DILaYNEAh9-Nsmqow9eILwTW0jFQAdpi520Tk,VzrpNlfUCarsQdh_M3fn6LevsGBQNAjitlZ5bh4Hr0U",
    "GEMINI_IDENTIFY_GROUNDING": "true",
    "GOOGLE_VISUAL_SEARCH_ENABLED": "true",
    "GOOGLE_VISUAL_SEARCH_MONTHLY_REQUEST_LIMIT": "900",
    "RUNWAY_GENERATION_ENABLED": "true",
    "RUNWAY_INITIAL_TEST_CREDIT_LIMIT": "1000",
    "RUNWAY_MONTHLY_CREDIT_LIMIT": "6000",
    "RUNWAY_MAX_OUTPUT_BYTES": "104857600",
    "YAHOO_REQUEST_COORDINATOR_REQUIRED": "true",
    "SOCIAL_AUTOPILOT_ENABLED": "true",
    "X_EXPECTED_USERNAME": "hoshilu_app",
    "X_OAUTH_REDIRECT_URI": "https://hoshilu.app/api/oauth/x/callback",
    "X_PUBLISHING_ENABLED": "true",
    "X_EVERGREEN_AUTOPILOT_ENABLED": "true",
    "INSTAGRAM_EVERGREEN_AUTOPILOT_ENABLED": "true",
    "THREADS_EVERGREEN_AUTOPILOT_ENABLED": "true",
    "SELLER_ACCOUNT_NAME": "ITG GROUP",
    "SELLER_ALLOWED_TENANTS": "itg,itt,mc2",
    "SELLER_PLAN": "PARTNER"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "1,5,16,20,31,35,46,50 * * * *",
      "7,22,37,52 * * * *",
      "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "YAHOO_REQUEST_COORDINATOR",
        "class_name": "YahooRequestCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "yahoo-request-coordinator-v1",
      "new_sqlite_classes": ["YahooRequestCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "PRODUCT_DB",
      "database_name": "hoshilu-products",
      "database_id": "17629324-b771-4348-982c-c25da48c29b2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SOCIAL_MEDIA_BUCKET",
      "bucket_name": "hoshilu-social-media"
    }
  ]
}
