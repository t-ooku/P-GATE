{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOSHILU teacher dataset daily batch",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query_text",
      "locale",
      "persona",
      "user_intent",
      "ideal_answer",
      "reason",
      "category",
      "search_terms",
      "excluded_conditions",
      "confidence",
      "authored_date",
      "authored_updated_date"
    ],
    "properties": {
      "query_text": {
        "type": "string",
        "minLength": 1,
        "description": "検索文。ユーザーが実際に打ちそうな原文（曖昧・断片・ローマ字混在を含む）。"
      },
      "locale": {
        "enum": ["ja", "en", "ko", "zh", "mixed"],
        "description": "query_text自体が書かれている言語。ローマ字/多言語混在は mixed。"
      },
      "persona": {
        "enum": ["child", "elderly", "foreign", "general"],
        "description": "対象ペルソナ。子ども/高齢者/外国人検索カバレッジを追跡するための追加項目（CTO指示書のカバレッジ要件⑤⑥⑦を検証可能にするため設計時に追加）。"
      },
      "user_intent": {
        "type": "string",
        "minLength": 1,
        "description": "ユーザー意図。何を探しているかの解釈。"
      },
      "ideal_answer": {
        "type": "string",
        "minLength": 1,
        "description": "理想回答。断定できる商品カテゴリ、または曖昧すぎる場合は確認質問の文面。"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "description": "理由。ideal_answerをそう判断した根拠。"
      },
      "category": {
        "type": "string",
        "minLength": 1,
        "description": "カテゴリ。product-types.json等の既存カテゴリIDと将来的に統合可能な自由記述。未分類は UNCLASSIFIED。"
      },
      "search_terms": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ja": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "en": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "ko": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "zh": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "description": "検索語（日/英/韓/中）。各モール検索窓へそのまま投入できる語を持つ。"
      },
      "excluded_conditions": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true,
        "description": "除外条件。原文の否定語・除外すべき属性。"
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "信頼度。0-1。"
      },
      "authored_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "作成日（教師データとして起票された日）。"
      },
      "authored_updated_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "更新日。"
      },
      "actual_ctr": {
        "type": ["number", "null"],
        "minimum": 0,
        "maximum": 1,
        "default": null,
        "description": "将来項目: 実CTR。計測が確立するまでnull。"
      },
      "actual_cvr": {
        "type": ["number", "null"],
        "minimum": 0,
        "maximum": 1,
        "default": null,
        "description": "将来項目: 実CVR。"
      },
      "actual_search_success_rate": {
        "type": ["number", "null"],
        "minimum": 0,
        "maximum": 1,
        "default": null,
        "description": "将来項目: 実検索成功率。"
      }
    }
  }
}
